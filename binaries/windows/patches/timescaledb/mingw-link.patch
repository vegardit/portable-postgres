@@ -49,8 +46,6 @@ if(WIN32 OR (CMAKE_SYSTEM_NAME STREQUAL "FreeBSD"))
 endif()
 
 if(WIN32)
-  set(CMAKE_MODULE_LINKER_FLAGS
-      "${CMAKE_MODULE_LINKER_FLAGS} ${PG_LIBDIR}/postgres.lib ws2_32.lib Version.lib"
-  )
+  link_libraries("${PG_LIBDIR}/libpostgres.a" ws2_32 version)
   set(CMAKE_C_FLAGS "-D_CRT_SECURE_NO_WARNINGS")
