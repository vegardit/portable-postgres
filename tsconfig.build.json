{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Emits the build tooling to dist, so that tests prove that the compiled modules still find the repository.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true
  },
  "include": [
    "binaries/**/*.ts"
  ]
}
